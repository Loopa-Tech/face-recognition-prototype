# Copy to .env at repository root. Never commit credentials.
PUBLIC_BASE_URL=http://localhost:8000
ALPICTURIA_DATA=./var/alpicturia
# SMTP is required for email verification and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
MAIL_MESSAGE_DOMAIN=
# Google Search Console URL-prefix property verification code (not a secret).
GOOGLE_SITE_VERIFICATION=
# MCP stdio: supply a personal key created under /account.
ALPICTURIA_API_URL=http://127.0.0.1:8000
ALPICTURIA_API_TOKEN=
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
